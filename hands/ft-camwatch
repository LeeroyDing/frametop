#!/usr/bin/env python3
"""ft-camwatch: watches SteamVR's XRService log for the camera failure that turns off the
headset's upper cameras and IR light (a VCINT FPGA load that fails, usually after a wake;
hands/camcheck.py), tells the Frametop desktop, and can restart SteamVR by itself.

It also watches for the re-sync loop: after some system suspends XRService logs "Set upper
camera driver not in-sync" and then re-syncs the upper cameras without end (200 to 700 "Sync
done fully" lines a minute, against 2 to 6 for a healthy wake). Each re-sync drops camera
frames, so ft-camd gets 1 to 15 fps from cameras that give 30 and hand tracking is slow until
SteamVR restarts. camcheck.py calls this "ok": all four cameras stay open. For this one the
notification has a Restart SteamVR button, and it never restarts by itself: the loop only
shows while the headset is worn. The desktop's popup can be far off to one side of where you
look, so a notice also shows in front of your eyes for a few seconds (layout/countdown's
helper) and says the button is there.

Off by default: hands/frametop-camwatch.service is a template the installer doesn't enable.
Settings in ~/.config/frametop.conf:
  CAMWATCH_AUTO_RESTART=1    restart SteamVR on a failure (default 0: only a notification). Only
                             while the headset isn't worn (frame-job's check: vrcompositor runs and
                             a backlight is on), after it has been off for CAMWATCH_IDLE_S, with no
                             Steam-launched app running and nobody on the remote desktop (VNC).
                             At most once per failure, and not again within CAMWATCH_COOLDOWN_MIN.
  CAMWATCH_IDLE_S=60         how long the headset must be off first
  CAMWATCH_COOLDOWN_MIN=30   the least time between two automatic restarts
  CAMWATCH_IGNORE_APPIDS=    Steam app ids that don't count as a running VR app (comma-separated)
  CAMWATCH_NOTIFY=1          post a notification in the Frametop desktop (0: log only)
  CAMWATCH_SYNC_PER_MIN=100  the re-sync loop: this many re-syncs read within a minute (0: don't watch for it)
  CAMWATCH_RENOTIFY_MIN=10   the re-sync loop: the least time between two of its notifications
  CAMWATCH_RESTART_DESKTOP=1 after the notification's button restarted SteamVR, start the Frametop desktop
                             again once SteamVR is up (0: start it yourself; AUTOSTART=1 does it anyway)
  CAMWATCH_BANNER_S=8        the re-sync loop: how long the notice in front of your eyes shows (0: none)

A SteamVR restart also closes the Frametop desktop and every window in it (ft-screens quits
with SteamVR, and the desktop's unit doesn't restart: see hands/README.md, "Camera check").

It follows the log with a stat every 2 s (no inotify, nothing else while all is well), and
logs every decision to stdout (the journal). --dry-run never notifies or restarts; --once
prints the state and what it would do now, and exits; --notify-test posts the re-sync loop's
notification and notice with a button that does nothing, to see how they show in the headset.
"""
import argparse
import collections
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "conf"))
import camcheck  # noqa: E402
import ft_conf  # noqa: E402

CONF = os.path.expanduser("~/.config/frametop.conf")
STATE = os.path.expanduser("~/.local/state/frametop/camwatch.json")
PAUSE = "/run/user/%d/frametop-pause.json" % os.getuid()    # input/game_pause.py's state
REPO = os.path.dirname(HERE)
NOTICE = os.path.join(REPO, "layout", "countdown", "build", "ft-reset-timer")
BACKLIGHTS = "/sys/class/backlight"
POLL_S = 2.0
MAX_READ = 16 << 20     # a poll reads at most this much of a log that grew
NOTIFY_TITLE = "Hand tracking: cameras off"
NOTIFY_TEXT = ("The headset's upper cameras and IR light are off: SteamVR couldn't start the colour camera "
               "module (it happens sometimes after the headset sleeps). Restart SteamVR, or the headset if "
               "that doesn't fix it. Restarting SteamVR closes this desktop and its windows.")
SYNC_LINE = "Sync done fully for cam"    # XRService, once per camera per re-sync
SYNC_WINDOW_S = 60.0
SYNC_TITLE = "Hand tracking is slow: cameras out of sync"
SYNC_TEXT = ("SteamVR keeps re-syncing the headset's upper cameras and dropping camera frames (it can start "
             "after the headset sleeps), so hand tracking gets only some of them. A SteamVR restart stops it. "
             "That closes this desktop and its windows.")
SYNC_TEXT_BACK = " The desktop starts again by itself."
SYNC_ACTION, SYNC_BUTTON = "restart", "Restart SteamVR"
SYNC_BANNER = ("Hand tracking is slow", ("The headset cameras are out of sync.",
                                         "Press Restart SteamVR on the desktop", "notification to fix it."))
NOTIFY_RETRY_S = 30.0   # with no desktop to notify, try again this much later
DEFAULTS = {"CAMWATCH_AUTO_RESTART": "0", "CAMWATCH_IDLE_S": "60", "CAMWATCH_COOLDOWN_MIN": "30",
            "CAMWATCH_IGNORE_APPIDS": "", "CAMWATCH_NOTIFY": "1", "VNC_PORT": "5900",
            "CAMWATCH_SYNC_PER_MIN": "100", "CAMWATCH_RENOTIFY_MIN": "10", "CAMWATCH_RESTART_DESKTOP": "1",
            "CAMWATCH_BANNER_S": "8"}


def log(text):
    print("%s %s" % (time.strftime("%H:%M:%S"), text), flush=True)


def read_conf(path=CONF):
    """frametop.conf's settings (docs/config.md) over DEFAULTS."""
    return {**DEFAULTS, **ft_conf.read(path)}


def conf_int(conf, key):
    return int(ft_conf.number(conf, key, float(DEFAULTS.get(key, "0") or 0)))


# ------------------------------------------------------------------------------------------
# What's going on around (all read-only, from /proc and /sys)

def process_running(name):
    for pid in os.listdir("/proc"):
        if pid.isdigit():
            try:
                with open("/proc/%s/comm" % pid) as f:
                    if f.read().strip() == name:
                        return True
            except OSError:
                pass
    return False


def headset_worn(backlights=BACKLIGHTS):
    """frame-job's check: vrcompositor runs and any panel's backlight is on (SteamVR turns the
    panels off 5 s after the headset comes off)."""
    lit = False
    try:
        for name in os.listdir(backlights):
            try:
                with open(os.path.join(backlights, name, "brightness")) as f:
                    lit = lit or int(f.read().strip()) > 0
            except (OSError, ValueError):
                pass
    except OSError:
        return False
    return lit and process_running("vrcompositor")


def vr_apps(ignore=()):
    """Apps Steam launched ("SteamLaunch AppId=N" in a process's arguments, as Steam's reaper
    runs them): ["AppId=N ..."]. Steam's own processes, SteamVR's and Frametop's services aren't
    launched this way. A guess: no VR game has been run on the Frame to confirm the form."""
    out = set()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        argv = camcheck.proc_argv(pid)
        if "SteamLaunch" not in argv:
            continue
        ids = [a.split("=", 1)[1] for a in argv if a.startswith("AppId=")]
        if ids and ids[0] not in ignore:
            out.add("AppId=" + ids[0])
    return sorted(out)


def remote_viewers(port=5900, tables=("/proc/net/tcp", "/proc/net/tcp6")):
    """Established connections to the remote desktop's VNC port, from /proc/net/tcp(6)."""
    out = []
    for path in tables:
        try:
            with open(path) as f:
                next(f)
                for line in f:
                    p = line.split()
                    if len(p) > 3 and p[3] == "01" and int(p[1].rsplit(":", 1)[1], 16) == port:
                        out.append(p[2])
        except (OSError, StopIteration, ValueError):
            pass
    return out


def frametop_bus():
    """The Frametop desktop's D-Bus (from its plasmashell, as decoration/apply.sh finds it), or None."""
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open("/proc/%s/comm" % pid) as f:
                if f.read().strip() != "plasmashell":
                    continue
            with open("/proc/%s/environ" % pid, "rb") as f:
                env = dict(kv.split(b"=", 1) for kv in f.read().split(b"\0") if b"=" in kv)
        except OSError:
            continue
        if env.get(b"XDG_RUNTIME_DIR", b"").endswith(b"/frametop") and b"DBUS_SESSION_BUS_ADDRESS" in env:
            return env[b"DBUS_SESSION_BUS_ADDRESS"].decode()
    return None


def notify(title, text):
    bus = frametop_bus()
    if not bus:
        log("no Frametop desktop running: no notification")
        return False
    r = subprocess.run(["notify-send", "-a", "Frametop", "-u", "critical", "-i", "dialog-warning", title, text],
                       env=dict(os.environ, DBUS_SESSION_BUS_ADDRESS=bus), capture_output=True, text=True,
                       timeout=10)
    if r.returncode:
        log("notify-send failed (%d): %s" % (r.returncode, r.stderr.strip()))
    return r.returncode == 0


def restart_steamvr():
    # --no-block: the job runs in systemd; the Frametop desktop closing doesn't cut it short.
    r = subprocess.run(["systemctl", "--user", "restart", "--no-block", "steamvr.service"],
                       capture_output=True, text=True, timeout=30)
    log("systemctl --user restart steamvr.service: exit %d %s" % (r.returncode, (r.stderr or "").strip()))
    return r.returncode == 0


def notify_action(title, text, action, button):
    """A notification with one button. Returns its notify-send process, which stays until the
    notification is closed and prints the action's name if the button was pressed; None with no
    Frametop desktop to show it in."""
    bus = frametop_bus()
    if not bus:
        return None
    try:
        return subprocess.Popen(["notify-send", "-a", "Frametop", "-u", "critical", "-i", "dialog-warning",
                                 "-A", "%s=%s" % (action, button), title, text],
                                env=dict(os.environ, DBUS_SESSION_BUS_ADDRESS=bus), stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True)
    except OSError as e:
        log("notify-send failed: %s" % e)
        return None


def note_pressed(note):
    """None while the notification is up; then whether its button was pressed (False: closed)."""
    if note.poll() is None:
        return None
    try:
        out = note.stdout.read()
    except (OSError, ValueError):
        out = ""
    return SYNC_ACTION in out.split()


def drop_note(note):
    """Ends a notification's notify-send (the notification itself stays up; its button then does nothing)."""
    try:
        note.terminate()
        note.wait(timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


def frametop_paused(path=PAUSE):
    """Frametop is paused, for a VR game or by hand (its panels are hidden)."""
    try:
        with open(path) as f:
            return bool(json.load(f).get("paused"))
    except (OSError, ValueError, AttributeError):
        return False


def banner_command(title, lines, seconds, now):
    """layout/countdown's helper as a notice, in the release's container and a unit of its own:
    podman's client alone is more than this service's memory limit. The deadline keeps a late
    container start from showing it stale; the unit's own limit ends a stuck one."""
    cmd = ["systemd-run", "--user", "--collect", "--quiet", "--unit", "frametop-camwatch-notice",
           "-p", "RuntimeMaxSec=%d" % (seconds + 20), os.path.join(REPO, "scripts", "in-box"), NOTICE,
           "--deadline", "%.9f" % (now + seconds + 10), "--seconds", str(seconds), "--notice", title]
    for line in lines:
        cmd += ["--line", line]
    return cmd


def show_banner(conf):
    """The re-sync loop's notice in front of the eyes, for CAMWATCH_BANNER_S (1 to 60; 0: none)."""
    seconds = min(conf_int(conf, "CAMWATCH_BANNER_S"), 60)
    if seconds <= 0:
        return False
    if not os.access(NOTICE, os.X_OK):
        log("no notice in the headset: %s isn't built" % NOTICE)
        return False
    try:
        r = subprocess.run(banner_command(SYNC_BANNER[0], SYNC_BANNER[1], seconds, time.monotonic()),
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as e:
        log("no notice in the headset: %s" % e)
        return False
    if r.returncode:
        log("no notice in the headset: systemd-run exit %d %s" % (r.returncode, (r.stderr or "").strip()))
    return r.returncode == 0


def start_desktop():
    """desktops.sh start, in a unit of its own (this service's CPU and memory limits aren't for it)."""
    script = os.path.join(REPO, "desktops.sh")
    r = subprocess.run(["systemd-run", "--user", "--collect", "--quiet", "--unit", "frametop-camwatch-desktop",
                        script, "start"], capture_output=True, text=True, timeout=30)
    log("starting the Frametop desktop again (%s start): exit %d %s" % (script, r.returncode, (r.stderr or "").strip()))
    return r.returncode == 0


def sync_text(conf):
    back = conf.get("CAMWATCH_RESTART_DESKTOP", "1") != "0" or conf.get("AUTOSTART") == "1"
    return SYNC_TEXT + (SYNC_TEXT_BACK if back else "")


def environment(conf):
    ignore = tuple(a.strip() for a in conf.get("CAMWATCH_IGNORE_APPIDS", "").replace(",", " ").split() if a.strip())
    return {"steamvr": camcheck.xrservice_pid() is not None, "worn": headset_worn(),
            "vr_apps": vr_apps(ignore), "remote": remote_viewers(conf_int(conf, "VNC_PORT"))}


# ------------------------------------------------------------------------------------------
# The decision (pure: tests feed it made-up states)

def new_memory():
    return {"pending": "", "notified": [], "restarted": {}, "last_restart": 0.0, "idle_since": None, "why": "",
            "sync_since": None, "sync_notified": 0.0}


def decide(now, failure, env, mem, conf):
    """What to do now. failure: the current VCINT failure's id ("" if none: the cameras run,
    or they're closed); env: {"steamvr", "worn", "vr_apps", "remote"} (only looked at while a
    failure is current); mem: new_memory(), updated in place; now: wall-clock seconds.
    Returns [("log", text) | ("notify", failure) | ("restart", failure)]."""
    acts = []
    if not failure:
        if mem["pending"]:
            acts.append(("log", "failure %s is no longer current" % mem["pending"]))
        mem.update(pending="", idle_since=None, why="")
        return acts
    if mem["pending"] != failure:
        mem.update(pending=failure, why="")
        acts.append(("log", "VCINT failure: %s (upper cameras and IR light off)" % failure))
    if failure not in mem["notified"]:
        mem["notified"] = (mem["notified"] + [failure])[-20:]
        if conf.get("CAMWATCH_NOTIFY", "1") != "0":
            acts.append(("notify", failure))
    if env.get("worn"):
        mem["idle_since"] = None
    elif mem["idle_since"] is None:
        mem["idle_since"] = now
    idle_s = conf_int(conf, "CAMWATCH_IDLE_S")
    cooldown = conf_int(conf, "CAMWATCH_COOLDOWN_MIN") * 60
    if conf.get("CAMWATCH_AUTO_RESTART", "0") != "1":
        why = "no automatic restart (CAMWATCH_AUTO_RESTART=1 in ~/.config/frametop.conf turns it on)"
    elif failure in mem["restarted"]:
        why = "SteamVR was restarted once for this failure already: restart the headset"
    elif mem["last_restart"] and now - mem["last_restart"] < cooldown:
        why = "no restart: the last automatic one was %d min ago (cooldown %d min)" % (
            (now - mem["last_restart"]) // 60, cooldown // 60)
    elif not env.get("steamvr"):
        why = "no restart: SteamVR isn't running"
    elif env.get("worn"):
        why = "no restart while the headset is worn"
    elif env.get("vr_apps"):
        why = "no restart: a VR app is running (%s)" % ", ".join(env["vr_apps"])
    elif env.get("remote"):
        why = "no restart: someone is on the remote desktop (%s)" % ", ".join(env["remote"])
    elif now - mem["idle_since"] < idle_s:
        why = "waiting for the headset to stay off for %d s" % idle_s
    else:
        mem["restarted"][failure] = now
        mem["last_restart"] = now
        why = "restarting SteamVR (the headset is off, nothing else in VR)"
        acts.append(("log", why))
        acts.append(("restart", failure))
        mem["why"] = why
        return acts
    if why != mem["why"]:
        mem["why"] = why
        acts.append(("log", why))
    return acts


def decide_sync(now, rate, note_up, mem, conf):
    """The re-sync loop's part. rate: SyncLoop.rate(), the re-syncs read in the last minute;
    note_up: its notification is still showing; mem: new_memory(), updated in place; now:
    wall-clock seconds. It begins at CAMWATCH_SYNC_PER_MIN and ends under a quarter of that, so
    a loop that slows doesn't come and go. Returns [("log", text) | ("notify_sync", rate)]: a
    notification when it begins, and again while it lasts once the last one was closed and
    CAMWATCH_RENOTIFY_MIN has passed. Never a restart: that's the notification's button."""
    acts = []
    limit = conf_int(conf, "CAMWATCH_SYNC_PER_MIN")
    looping = limit > 0 and (rate >= limit or (mem["sync_since"] is not None and rate * 4 >= limit))
    if not looping:
        if mem["sync_since"] is not None:
            acts.append(("log", "the upper cameras' re-sync loop stopped (%d re-syncs in the last minute)" % rate))
        mem["sync_since"] = None
        return acts
    if mem["sync_since"] is None:
        mem["sync_since"] = now
        acts.append(("log", "the upper cameras are re-syncing in a loop: %d re-syncs in the last minute, so the "
                            "cameras drop frames and hand tracking is slow until SteamVR restarts" % rate))
    if (conf.get("CAMWATCH_NOTIFY", "1") != "0" and not note_up
            and now - mem["sync_notified"] >= conf_int(conf, "CAMWATCH_RENOTIFY_MIN") * 60):
        mem["sync_notified"] = now
        acts.append(("notify_sync", rate))
    return acts


class Relaunch:
    """After the button's SteamVR restart: when to start the Frametop desktop again. Once a new
    XRService, vrserver and vrcompositor all run, and still do settle_s later (the dashboard and
    its drivers come up just after the compositor: session/autostart.sh waits the same way)."""

    def __init__(self, old_pid, now, wait_s=180.0, settle_s=5.0):
        self.old_pid, self.deadline, self.settle_s, self.up_since = old_pid, now + wait_s, settle_s, None

    def step(self, now, xr_pid, up):
        """"wait", "start" or "gave up". xr_pid: XRService's pid now (None: not running);
        up: vrserver and vrcompositor run; now: monotonic seconds."""
        if xr_pid is not None and xr_pid != self.old_pid and up:
            if self.up_since is None:
                self.up_since = now
            if now - self.up_since >= self.settle_s:
                return "start"
        else:
            self.up_since = None
        return "gave up" if now > self.deadline else "wait"


def load_memory(path=STATE):
    mem = new_memory()
    try:
        with open(path) as f:
            saved = json.load(f)
        mem["notified"] = list(saved.get("notified", []))[-20:]
        mem["restarted"] = dict(saved.get("restarted", {}))
        mem["last_restart"] = float(saved.get("last_restart", 0.0))
    except (OSError, ValueError, TypeError, AttributeError):
        pass
    return mem


def save_memory(mem, path=STATE):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"notified": mem["notified"], "restarted": mem["restarted"],
                   "last_restart": mem["last_restart"]}, f)
    os.replace(tmp, path)


# ------------------------------------------------------------------------------------------
# Following the log

class SyncLoop:
    """XRService's camera re-syncs over the last SYNC_WINDOW_S, timed by when they were read
    (the log's own clock isn't trusted)."""

    def __init__(self):
        self.seen = collections.deque()    # (monotonic seconds, lines)

    def add(self, now, lines):
        if lines > 0:
            self.seen.append((now, lines))

    def rate(self, now):
        while self.seen and now - self.seen[0][0] > SYNC_WINDOW_S:
            self.seen.popleft()
        return sum(n for _, n in self.seen)


class Follower:
    """The running XRService's log, read as it grows. A new log (SteamVR restarted) starts afresh.
    It also counts the re-syncs it reads (SyncLoop), but only once it has caught up with the log:
    what a log already held when it was first opened says nothing about now."""

    def __init__(self, path=None, clock=time.monotonic):
        self.fixed = path
        self.path, self.ino, self.offset, self.rest = "", None, 0, ""
        self.state = None
        self.clock = clock
        self.sync = SyncLoop()
        self.caught_up = False

    def poll(self):
        path = self.fixed or camcheck.newest_log()
        if not path:
            return None
        try:
            st = os.stat(path)
        except OSError:
            return self.state
        if path != self.path or st.st_ino != self.ino or st.st_size < self.offset:
            self.path, self.ino, self.offset, self.rest = path, st.st_ino, 0, ""
            self.state = camcheck.LogState(path)
            self.sync, self.caught_up = SyncLoop(), False
            log("following %s" % path)
        if st.st_size > self.offset:
            with open(path, "rb") as f:
                f.seek(self.offset)
                data = f.read(MAX_READ)
            self.offset += len(data)
            text = self.rest + data.decode(errors="replace")
            lines = text.split("\n")
            self.rest = lines.pop()
            syncs = 0
            for line in lines:
                self.state.feed(line)
                syncs += SYNC_LINE in line
            if self.caught_up:
                self.sync.add(self.clock(), syncs)
        if self.offset >= st.st_size:
            self.caught_up = True
        return self.state

    def sync_rate(self):
        return self.sync.rate(self.clock())


def current_failure(state, steamvr_running=True):
    """The failure id if the log's current camera start is a VCINT failure, else ""."""
    if state is None or not steamvr_running:
        return ""
    snap = state.snapshot()
    return snap["failure"] if snap["status"] == "degraded" and snap["reason"] == camcheck.VCINT_REASON else ""


def act(acts, dry):
    changed = False
    for kind, arg in acts:
        if kind == "log":
            log(arg)
        elif kind == "notify":
            changed = True
            if dry:
                log("(dry run) would notify: %s" % NOTIFY_TITLE)
            else:
                notify(NOTIFY_TITLE, NOTIFY_TEXT)
        elif kind == "restart":
            changed = True
            if dry:
                log("(dry run) would restart SteamVR")
            else:
                restart_steamvr()
    return changed


def steamvr_up():
    return process_running("vrserver") and process_running("vrcompositor")


class SyncAlert:
    """The re-sync loop's notification, its button and the desktop's return: what main does about
    them each poll. Everything it does to the system goes through `do`, so tests can stand in."""

    def __init__(self, dry=False, do=None):
        self.dry = dry
        self.do = {"post": lambda conf: notify_action(SYNC_TITLE, sync_text(conf), SYNC_ACTION, SYNC_BUTTON),
                   "pressed": note_pressed, "drop": drop_note, "restart": restart_steamvr,
                   "desktop": start_desktop, "xr_pid": camcheck.xrservice_pid, "up": steamvr_up,
                   "has_desktop": lambda: frametop_bus() is not None, "banner": show_banner,
                   "paused": frametop_paused}
        self.do.update(do or {})
        self.note, self.note_log = None, ""    # the notification showing, and the log it was about
        self.relaunch = None
        self.last_log = ""
        self.quiet = ""                        # why no notification went out, said once

    def say(self, text):
        if text != self.quiet:
            self.quiet = text
            log(text)

    def press(self, mono, conf):
        pid = self.do["xr_pid"]()
        back = (conf.get("CAMWATCH_RESTART_DESKTOP", "1") != "0" and conf.get("AUTOSTART") != "1"
                and self.do["has_desktop"]())
        log("the notification's %s button was pressed: restarting SteamVR%s"
            % (SYNC_BUTTON, "; the desktop starts again once it's up" if back else ""))
        if self.do["restart"]() and back:
            self.relaunch = Relaunch(pid, mono)

    def step(self, wall, mono, rate, log_path, mem, conf):
        """wall, mono: wall-clock and monotonic seconds; rate: Follower.sync_rate(); log_path: the
        log followed (a new one means SteamVR restarted)."""
        if log_path != self.last_log:
            self.last_log = log_path
            mem["sync_notified"] = 0.0         # a new SteamVR: a new loop gets its notification at once
        if self.note is not None:
            if log_path != self.note_log:
                # The loop it was about went with that SteamVR: its button mustn't restart this one.
                self.do["drop"](self.note)
                self.note = None
            else:
                pressed = self.do["pressed"](self.note)
                if pressed is not None:
                    self.note = None
                    if pressed:
                        self.press(mono, conf)
                    else:
                        log("the re-sync notification was closed without its button")
        if self.relaunch is not None:
            what = self.relaunch.step(mono, self.do["xr_pid"](), self.do["up"]())
            if what == "start":
                self.relaunch = None
                self.do["desktop"]()
            elif what == "gave up":
                self.relaunch = None
                log("SteamVR didn't come up within 3 minutes: start the desktop from the library")
        for kind, arg in decide_sync(wall, rate, self.note is not None, mem, conf):
            if kind == "log":
                log(arg)
            elif self.dry:
                log("(dry run) would notify: %s" % SYNC_TITLE)
            else:
                # Not into a VR game: Frametop's panels are hidden there, and hands aren't tracked.
                paused = self.do["paused"]()
                self.note, self.note_log = (None if paused else self.do["post"](conf)), log_path
                if self.note is None:
                    mem["sync_notified"] = wall - conf_int(conf, "CAMWATCH_RENOTIFY_MIN") * 60 + NOTIFY_RETRY_S
                    self.say("%s: the notification waits (trying every %d s while the loop lasts)"
                             % ("Frametop is paused" if paused else "no Frametop desktop to notify", NOTIFY_RETRY_S))
                else:
                    self.quiet = ""
                    log("notified: %s" % SYNC_TITLE)
                    self.do["banner"](conf)


def notify_test(conf):
    """--notify-test: the re-sync loop's notification as it would show, its button doing nothing."""
    note = notify_action(SYNC_TITLE, "(Only a test: the button does nothing.) " + sync_text(conf),
                         SYNC_ACTION, SYNC_BUTTON)
    if note is None:
        log("no Frametop desktop running: no notification")
        return 1
    show_banner(conf)
    log("posted; waiting for its button, or for it to be closed")
    while True:
        pressed = note_pressed(note)
        if pressed is not None:
            break
        time.sleep(0.5)
    log("the button was pressed (a test: nothing restarts)" if pressed else "closed without the button")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(description="Watch for the camera failure that turns off the upper cameras, "
                                             "and for the re-sync loop that slows hand tracking.")
    ap.add_argument("--dry-run", action="store_true", help="log what it would do; never notify or restart")
    ap.add_argument("--once", action="store_true", help="look once, print the decision (a dry run), and exit")
    ap.add_argument("--log", help="follow this file instead of the running XRService's log (tests)")
    ap.add_argument("--state", default=STATE, help="where it remembers past failures (default %(default)s)")
    ap.add_argument("--notify-test", action="store_true",
                    help="post the re-sync loop's notification with a button that does nothing, and say what "
                         "happened to it")
    a = ap.parse_args(argv)
    if a.notify_test:
        return notify_test(read_conf())
    dry = a.dry_run or a.once
    mem = load_memory(a.state)
    follower = Follower(a.log)
    conf = read_conf()
    conf_mtime = 0.0
    alert = SyncAlert(dry)
    log("watching; automatic restart %s; the re-sync loop at %d re-syncs a minute"
        % ("on" if conf.get("CAMWATCH_AUTO_RESTART") == "1" else "off", conf_int(conf, "CAMWATCH_SYNC_PER_MIN")))
    while True:
        try:
            m = os.stat(CONF).st_mtime
        except OSError:
            m = 0.0
        if m != conf_mtime:
            conf, conf_mtime = read_conf(), m
        state = follower.poll()
        failure = current_failure(state)
        env = {}
        if failure or mem["pending"]:
            env = environment(conf)
            if not env["steamvr"] and not a.log:
                failure = ""   # the log's last word, but XRService is gone
        acts = decide(time.time(), failure, env, mem, conf)
        if a.once:
            snap = state.snapshot() if state else {"status": "unknown", "reason": "no log"}
            print("log: %s\nstate: %s %s\nenvironment: %s" % (follower.path, snap["status"], snap["reason"],
                                                              json.dumps(env)))
            act(acts, True)
            print("re-sync loop: not told by one look (it counts the re-syncs logged while it watches)")
            return 0
        if act(acts, dry) and not dry:
            save_memory(mem, a.state)
        alert.step(time.time(), time.monotonic(), follower.sync_rate(), follower.path, mem, conf)
        time.sleep(POLL_S)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
